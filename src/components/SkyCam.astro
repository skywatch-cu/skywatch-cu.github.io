---
/**
 * The live Front Range sky camera: a fixed 16:9 view toward the foothills.
 * The image has a stable URL on the legacy server, so it refreshes client-side.
 */
import { LEGACY_ORIGIN } from '../lib/legacy.ts';
import { bucket, camSrcset } from '../lib/camera.ts';

interface Props {
  caption?: string;
  /** Rendered width of the image, for choosing among the resized copies. */
  sizes?: string;
}
const { caption = 'Front Range sky camera, refreshed every 2 minutes.', sizes = '100vw' } = Astro.props;
const src = `${LEGACY_ORIGIN}/data/skycam/fixed.jpg`;
const FULL_WIDTH = 3840;
---

<figure class="skycam">
  <div class="frame">
    <img class="cam" data-live data-full-width={FULL_WIDTH} src={src} srcset={camSrcset(src, FULL_WIDTH, bucket())} sizes={sizes} alt="Current view of the sky and the Front Range foothills from the observatory" width={FULL_WIDTH} height="2160" />
    <span class="mask" aria-hidden="true"></span>
  </div>
  {caption && <figcaption><Fragment set:html={caption} /></figcaption>}
</figure>

<script>
  import '../lib/live-images.ts';
</script>

<style>
  .frame {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius);
  }
  /*
   * Covers the BoulderCast logo burned into the camera's caption strip. In the 3840 × 2160 frame
   * the strip spans y = 2010–2159 in rgb(185 130 73); the logo spans x = 47–565, and the CU logo
   * begins at x = 652. Percentages keep the patch on the logo at any rendered size.
   */
  .mask {
    position: absolute;
    left: 0;
    bottom: 0;
    width: calc(610 / 3840 * 100%);
    height: calc(150 / 2160 * 100%);
    background: rgb(185 130 73);
  }
  .cam {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    background: linear-gradient(#2a4a72, #0c1a2b);
  }
</style>
