---
/** Latest Area Forecast Discussion from the NWS Boulder office, split into its sections. */
import { getForecastBundle } from '../lib/snapshot.ts';
import { fmtTime, renderDiscussion } from '../lib/render/forecast.ts';

const d = getForecastBundle()?.discussion;
---

<div class="afd">
  <p class="afd-issued muted small">
    {d ? `Issued ${fmtTime(d.issued)} by NWS Denver/Boulder.` : 'The forecast discussion didn’t load at the last update.'}
  </p>
  <div class="afd-body" set:html={d ? renderDiscussion(d) : ''} />
</div>

<script>
  import { onForecast } from '../lib/forecast-client.ts';
  import { fmtTime, renderDiscussion } from '../lib/render/forecast.ts';

  const issued = document.querySelector<HTMLElement>('.afd-issued');
  const body = document.querySelector<HTMLElement>('.afd-body');
  let shown = '';
  if (issued && body)
    onForecast((b) => {
      const d = b.discussion;
      if (!d || d.issued === shown) return;
      shown = d.issued;
      issued.textContent = `Issued ${fmtTime(d.issued)} by NWS Denver/Boulder.`;
      body.innerHTML = renderDiscussion(d);
    });
</script>

<style>
  .afd-body :global(.afd-sec) {
    border-top: 1px solid var(--rule);
    padding-block: 0.6rem;
  }
  .afd-body :global(summary) {
    cursor: pointer;
  }
  .afd-body :global(summary h3) {
    display: inline;
    font-size: var(--step-1);
  }
  .afd-body :global(.afd-sec[open] summary) {
    margin-bottom: 0.6rem;
  }
  .afd-body :global(ul) {
    max-width: var(--measure);
    padding-left: 1.2rem;
  }
  .afd-body :global(li) {
    margin-bottom: 0.4rem;
  }
</style>
